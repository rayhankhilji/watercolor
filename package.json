{
  "name": "watercolor-cli",
  "version": "0.1.0",
  "description": "Turn any URL into a complete brand identity toolkit: tokens, WATERCOLOR.md, logo kit, motion, patterns, social assets and a brand book. Built as an Agent Skill + CLI.",
  "type": "module",
  "bin": {
    "watercolor": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "brand",
    "branding",
    "design-tokens",
    "brand-identity",
    "agent-skill",
    "claude-code",
    "design-system",
    "motion",
    "brand-guidelines",
    "watercolor"
  ],
  "author": "Rayhan Khilji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayhankhilji/watercolor.git"
  },
  "homepage": "https://github.com/rayhankhilji/watercolor#readme",
  "bugs": "https://github.com/rayhankhilji/watercolor/issues",
  "dependencies": {
    "commander": "^15.0.0",
    "culori": "^4.0.2",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.0",
    "svgo": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
